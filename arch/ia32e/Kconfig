menu "ia32e Configuration"

# CMake configs

config CMAKELISTS_SUBDIR
    string 
    default "arch/ia32e"

# Kernel configs

config IA32E_KSTACK_SIZE
    int "Kernel stack size"
    default 4096
    range 4096 65536
    ---help---
        Size of each kernel stack in bytes.
        
config IA32E_KMAX_SIZE_MB
    int "Maximum kernel size (MB)"
    default 4
    range 2 512

config IA32E_MULTIBOOT2
    bool "Multiboot2"
    default y
    ---help---
        Enable support for booting as a multiboot2 module

config IA32E_MAX_VMA_PARTITIONS
    int "Maximum number of vma partitions"
    range 1 511
    ---help---
        Sets the maximum number of vma partitions supported by WorkhorseRT
        on the ia32e architecture

config IA32E_VMA_EARLY_PARTITION_TABLE_COUNT
    int "Number of vma partitions used by early vma"
    range 1 511
    ---help---
        Sets the number of vma partitions used by WorkhorseRT early vma
        on the ia32e architecture

config IA32E_MAX_IOAPICS
    int "Maximum number of IOAPICs"
    default 2
    range 1 32
    ---help---
        Sets the maximum number of IOAPICs supported by WorkhorseRT
        on the ia32e architecture

config IA32E_APPLY_MADT_NMI_OVERRIDES
    bool "Apply MADT NMI overrides"
    default n
    ---help---
        "Enable NMI overrides stated by the ACPI MADT"

config IA32E_APIC_CALIBRATION_TIME_MS
    int "Apic calibration time ms"
    default 1
    range 1 10
    ---help---
        "Amount of time taken to calibrate the Apic"

config IA32E_FEATURE_PCID
    bool "Enable PCID"
    default y
    ---help---
        "Enable PCID if supported"

config IA32E_FEATURE_UMIP
    bool "Enable UMIP"
    default y
    ---help---
        "Enable UMIP if supported"

endmenu